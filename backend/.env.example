# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_assistant

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_db

# --- LLM provider (used for summarization, Q&A generation) ---
# Supported providers: groq, gemini, anthropic, openai, mock
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Recommended high-throughput provider: Google Gemini (250K TPM, high availability)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-3.6-flash

# Alternative: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-sonnet-5

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

MOCK_FALLBACK=true

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Clause classification ---
# Backend engine: auto (default), llm (zero-RAM LLM classification), or transformer
CLASSIFICATION_BACKEND=auto
# Default: pretrained NLI model used zero-shot (distilled BART for fast inference & lower memory).
CLASSIFICATION_MODEL=valhalla/distilbart-mnli-12-3
# Optional: path to a locally fine-tuned LegalBERT/RoBERTa checkpoint. If set
# and loadable, this takes priority over the zero-shot model. Leave blank
# unless you actually have a trained checkpoint (see backend/train/README.md).
FINE_TUNED_MODEL_PATH=

# --- App ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
